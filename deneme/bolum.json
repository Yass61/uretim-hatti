 "cumleler": [
  {
   "id": "s1",
   "metin": "Ayet inince, en sevdiği bahçeyi Allah yoluna adadı."
  },
  {
   "id": "s2",
   "metin": "Ebû Talha, Medine'de hurmalığı en çok olan Ensârîydi.",
   "kaynak": "Buhârî 1461"
  },
  {
   "id": "s3",
   "metin": "En sevdiği mal, mescidin karşısındaki Beyruhâ bahçesiydi.",
   "kaynak": "Buhârî 1461"
  },
  {
   "id": "s4",
   "metin": "Resûlullah oraya girer, güzel suyundan içerdi.",
   "kaynak": "Buhârî 1461"
  },
  {
   "id": "s5",
   "metin": "Sonra şu ayet indi:",
   "altyazi": false
  },
  {
   "id": "tilavet",
   "bekle": 9.0
  },
  {
   "id": "s6",
   "metin": "Ebû Talha hemen kalktı:",
   "kaynak": "Buhârî 1461 · Müslim 998"
  },
  {
   "id": "s7",
   "metin": "“Yâ Resûlallah, en sevdiğim malım Beyruhâ.",
   "kaynak": "Buhârî 1461 · Müslim 998"
  },
  {
   "id": "s8",
   "metin": "Allah için sadaka olsun.",
   "kaynak": "Buhârî 1461 · Müslim 998"
  },
  {
   "id": "s9",
   "metin": "Allah sana nereyi gösterirse oraya koy.”",
   "kaynak": "Buhârî 1461 · Müslim 998"
  },
  {
   "id": "s10",
   "metin": "Resûlullah: “Ne güzel, kazançlı mal!",
   "kaynak": "Buhârî 1461 · Müslim 998"
  },
  {
   "id": "s11",
   "metin": "Söylediğini işittim.",
   "kaynak": "Buhârî 1461 · Müslim 998"
  },
  {
   "id": "s12",
   "metin": "Bence onu yakınlarına ver.”",
   "kaynak": "Buhârî 1461 · Müslim 998"
  },
  {
   "id": "s13",
   "metin": "Ebû Talha da bahçeyi akrabaları ve amcaoğulları arasında paylaştırdı.",
   "kaynak": "Buhârî 1461 · Müslim 998"
  },
  {
   "id": "s14",
   "metin": "Rûhu'l-Beyân'da şöyle geçer:",
   "kaynak": "Rûhu'l-Beyân, c. 2, s. 63"
  },
  {
   "id": "s15",
   "metin": "İnsan sevdiğini, ancak daha değerli bir sevgiliye ulaşacağına yakîn olunca verir.",
   "kaynak": "Rûhu'l-Beyân, c. 2, s. 63"
  },
  {
   "id": "s16",
   "metin": "Selef de sevdiği şeyi, ihtiyaç duyacakları gün için Allah'a azık yapardı.",
   "kaynak": "Rûhu'l-Beyân, c. 2, s. 63"
  }
 ],
